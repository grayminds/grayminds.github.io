# Vault canonical uses two spaces between sentences (per voice contract).
# Prettier's Markdown formatter collapses them to one space and has no option
# to preserve.  Excluding the prose-content directories prevents the publish
# loop from re-normalizing every file on every run.
_posts/**/*.md
_pages/**/*.md
_projects/**/*.md
_sass/font-awesome/*.scss
_scripts/*
# Ignore citation YAML file generated by script
_data/citations.yml
# Ignore jw-yearbook (Vite build output, minified)
jw-yearbook/**

# Component READMEs use two-space sentence separators per voice contract.
# Prettier collapses them; exclude README_*.md from formatting.
README_*.md
