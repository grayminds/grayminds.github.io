{% comment %}
  Unified education entry renderer for both RenderCV and JSONResume formats
  Full-width layout with location inline after institution name.
  Handles both:
  - RenderCV: institution, area, studyType (or degree), start_date, end_date, location, courses, highlights
  - JSONResume: institution, area, studyType, startDate, endDate, location, courses, highlights
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">

      {% comment %} Degree / study type {% endcomment %}
      {% capture study_type %}{% if entry.studyType %}{{ entry.studyType }}{% elsif entry.degree %}{{ entry.degree }}{% endif %}{% endcapture %}
      {% assign study_type = study_type | strip %}

      {% if entry.url %}
        <h6 class="title font-weight-bold">
          <a href="{{ entry.url }}">{{ study_type }}</a>
        </h6>
      {% elsif study_type != '' %}
        <h6 class="title font-weight-bold">{{ study_type }}</h6>
      {% endif %}

      {% comment %} Institution with location inline {% endcomment %}
      {% capture location %}{% if entry.location %}{{ entry.location }}{% endif %}{% endcapture %}
      {% assign location = location | strip %}

      {% if entry.institution %}
        <h6 style="font-size: 0.95rem">
          {{ entry.institution }}
          {% if location != '' %}
            <span style="color: #6c757d;"> | {{ location }}</span>
          {% endif %}
        </h6>
      {% endif %}

      {% comment %} Area of study (italic) {% endcomment %}
      {% if entry.area %}
        <p class="mb-2" style="font-size: 0.95rem; font-style: italic;">{{ entry.area }}</p>
      {% endif %}

      {% comment %} Date line (only shown if dates exist) {% endcomment %}
      {% capture start_date %}{% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}{% endcapture %}
      {% assign start_date = start_date | strip %}
      {% capture end_date %}{% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}{% endcapture %}
      {% assign end_date = end_date | strip %}

      {% if start_date != '' %}
        {% assign startYear = start_date | split: '-' | first %}
        {% assign endYear = end_date | split: '-' | first | default: 'Present' %}
        <p class="mb-2" style="font-size: 0.85rem; color: #6c757d;">
          <i class="fa-regular fa-calendar mr-1"></i>{{ startYear }} - {{ endYear }}
        </p>
      {% endif %}

      {% comment %} Courses and highlights {% endcomment %}
      {% if entry.courses or entry.highlights %}
        <ul class="items">
          {% for item in entry.courses %}
            <li>
              <span class="item">{{ item }}</span>
            </li>
          {% endfor %}
          {% for item in entry.highlights %}
            <li>
              <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

    </li>
  {% endfor %}
</ul>
