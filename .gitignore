# =============================================================================
# .gitignore for al-folio Jekyll site (GitHub Pages deployment)
# Repository: grayminds.github.io
# Updated: 2025-02-20
# =============================================================================

# -----------------------------------------------------------------------------
# Jekyll Build Output
# -----------------------------------------------------------------------------
# _site is generated by Jekyll on every build.  GitHub Pages rebuilds from
# source on each push, so committing _site bloats the repo and causes
# merge conflicts.
_site

# Jekyll caches and metadata used to speed up local incremental builds.
# These are machine-specific and should never be shared.
.jekyll-cache
.jekyll-metadata
.sass-cache

# -----------------------------------------------------------------------------
# Ruby / Bundler
# -----------------------------------------------------------------------------
# Bundler downloads gems into .bundle and vendor directories.
# These are resolved from Gemfile and should not be committed.
.bundle
vendor

# Gemfile.lock is excluded by al-folio convention.  GitHub Pages pins its
# own gem versions regardless of what the lock file says, so committing it
# can cause confusion between local and remote builds.
Gemfile.lock

# Ruby version manager files.  These vary by developer machine.
.ruby-version

# -----------------------------------------------------------------------------
# Node.js / JavaScript
# -----------------------------------------------------------------------------
# npm/yarn dependencies installed locally.  Resolved from package.json.
node_modules/

# al-folio copies required JS/CSS libraries from node_modules into
# assets/libs/ during setup.  These are generated files.
assets/libs/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
# Virtual environments (used by some al-folio features like Jupyter support).
.venv

# Python bytecode and Jupyter notebook checkpoints.
__pycache__/
*.pyc
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# al-folio Specific
# -----------------------------------------------------------------------------
# RenderCV output intermediates (Typst source files).
# Final PDFs in assets/rendercv/ should still be committed if needed.
assets/rendercv/rendercv_output/*.typ

# Tweet cache used by al-folio's Twitter embed feature.
.tweet-cache

# -----------------------------------------------------------------------------
# Windows
# -----------------------------------------------------------------------------
# Windows Explorer generates these automatically in browsed directories.
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# macOS
# -----------------------------------------------------------------------------
.DS_Store

# -----------------------------------------------------------------------------
# IDE / Editor
# -----------------------------------------------------------------------------
# JetBrains (WebStorm, RubyMine, etc.)
.idea

# VS Code workspace settings.  Exclude to avoid imposing editor config
# on collaborators.  Remove this line if you want to share settings.
.vscode/

# Vim/Emacs swap and backup files.
*~
*.swp
*.bak

# -----------------------------------------------------------------------------
# Environment and Secrets
# -----------------------------------------------------------------------------
# Local environment variable files.  May contain API keys or tokens.
# NEVER commit secrets to a public repository.
.env
*.local

# -----------------------------------------------------------------------------
# ImageMagick
# -----------------------------------------------------------------------------
# Temporary pixel cache files generated during image processing.
*.mpc
*.cache

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log

# =============================================================================
# REMINDER: Do NOT ignore these directories/files
# -----------------------------------------------------------------------------
# Gemfile          — defines Ruby dependencies; required for builds
# _bibliography/   — BibTeX files for publications
# _data/           — YAML data files driving site content
# _projects/       — project page content
# _posts/          — blog posts
# _pages/          — standalone pages
# _includes/       — Liquid template partials (.liquid files)
# _layouts/        — page layout templates
# _sass/           — custom SCSS (including main.scss imports)
# assets/img/      — images referenced by site content
# assets/pdf/      — PDFs (CV, papers, etc.)
# .github/         — GitHub Actions workflows and config
# =============================================================================