---
# Standalone layout for /bio/.  Does NOT extend default.liquid, so the
# al-folio navbar, footer, theme toggle, and main.css are absent on this
# page.  This is intentional:  /bio/ is a digital business card opened
# from a QR code on a phone, and it should load fast and stand alone.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  {%- assign bio = site.data.bio -%}

  <title>{{ page.title }} | grayminds.com</title>
  <meta name="description" content="{{ page.description }}">
  <meta name="author" content="{{ bio.profile.name }}">
  <meta name="robots" content="{{ page.robots | default: 'index,follow' }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta name="theme-color" content="#0e0e12">
  <meta name="color-scheme" content="dark">

  <!-- Open Graph / Twitter -->
  <meta property="og:type" content="profile">
  <meta property="og:title" content="{{ page.title }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:description" content="{{ page.description }}">
  {% if page.og_image %}<meta property="og:image" content="{{ site.url }}{{ page.og_image }}">{% endif %}
  <meta property="og:locale" content="en_US">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ page.title }}">
  <meta name="twitter:description" content="{{ page.description }}">
  {% if page.og_image %}<meta name="twitter:image" content="{{ site.url }}{{ page.og_image }}">{% endif %}

  <!-- Schema.org Person -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ bio.profile.name }}",
    "jobTitle": "{{ bio.vcard.title }}",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "{{ bio.vcard.city }}",
      "addressRegion": "{{ bio.vcard.region }}",
      "addressCountry": "{{ bio.vcard.country }}"
    },
    "url": "{{ site.url }}/bio/",
    "image": "{{ site.url }}{{ bio.profile.avatar }}"
  }
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="{{ '/assets/css/bio.css' | relative_url }}">

  <link rel="icon" href="{{ bio.profile.avatar | relative_url }}">
</head>
<body class="bio-page-body">

  {%- comment -%} Lucide icons inlined as SVG sprite, referenced via <use>. {%- endcomment -%}
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <symbol id="i-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></symbol>
      <symbol id="i-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></symbol>
      <symbol id="i-file" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5z"/><polyline points="14 2 14 8 20 8"/><path d="M16 13H8"/><path d="M16 17H8"/></symbol>
      <symbol id="i-arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></symbol>
      <symbol id="i-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></symbol>
    </defs>
  </svg>

  <header class="bio-hero">
    <div class="bio-avatar-frame">
      <svg class="bio-avatar-ring" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <polygon points="50,0.5 99.5,25.25 99.5,74.75 50,99.5 0.5,74.75 0.5,25.25" fill="none" stroke="#2b6df0" stroke-width="1" />
      </svg>
      <img class="bio-avatar"
           src="{{ bio.profile.avatar | relative_url }}"
           alt="{{ bio.profile.avatar_alt }}"
           loading="eager"
           decoding="async"
           width="294" height="294" />
    </div>
    <h1 class="bio-name">{{ bio.profile.name }}</h1>
    <p class="bio-title">{{ bio.profile.title }}</p>
    {% if bio.profile.subtitle %}<p class="bio-subtitle">{{ bio.profile.subtitle }}</p>{% endif %}
  </header>

  <main class="bio-content">

    {% if bio.credentials %}
    <hr class="bio-rule">
    <ul class="bio-credentials">
      {% for c in bio.credentials %}<li>{{ c }}</li>{% endfor %}
    </ul>
    {% endif %}

    {% if bio.profile.paragraphs %}
    <hr class="bio-rule">
    <div class="bio-paragraphs">
      {% for para in bio.profile.paragraphs %}
      <p>{{ para }}</p>
      {% endfor %}
    </div>
    {% endif %}

    {% if bio.status %}
    <div class="bio-status-wrapper">
      <span class="bio-status">{{ bio.status.label }}</span>
    </div>
    {% endif %}

    <hr class="bio-rule">

    {% if bio.primary_action %}
    <a class="bio-cta-primary"
       href="{{ bio.primary_action.href | relative_url }}"
       {% if bio.primary_action.type == 'vcard' %}download{% endif %}>
      <svg aria-hidden="true"><use href="#i-download"/></svg>
      {{ bio.primary_action.label }}
    </a>
    {% endif %}

    {% if bio.secondary_actions %}
    <div class="bio-cta-secondary-row">
      {% for action in bio.secondary_actions %}
        {% if action.type == 'email' %}
          <a class="bio-cta-secondary"
             href="mailto:{{ action.user }}@{{ action.domain }}"
             rel="nofollow noopener">
            <svg aria-hidden="true"><use href="#i-mail"/></svg>
            <span>{{ action.label }}</span>
          </a>
        {% elsif action.type == 'phone' %}
          {%- assign tel_digits = action.number | replace: '-', '' | replace: ' ', '' | replace: '(', '' | replace: ')', '' -%}
          <a class="bio-cta-secondary"
             href="tel:+1{{ tel_digits }}"
             rel="noopener">
            <svg aria-hidden="true"><use href="#i-phone"/></svg>
            <span>{{ action.label }}</span>
          </a>
        {% else %}
          <a class="bio-cta-secondary"
             href="{{ action.href | relative_url }}"
             rel="noopener">
            <svg aria-hidden="true"><use href="#i-file"/></svg>
            <span>{{ action.label }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    {% for section in bio.sections %}
    <section class="bio-section">
      <h2 class="bio-section-heading">{{ section.heading }}</h2>

      {% if section.links %}
      <ul class="bio-link-list">
        {% for link in section.links %}
        <li>
          <a href="{{ link.href }}" rel="noopener">
            <span>{{ link.label }}</span>
            <svg class="bio-chevron" aria-hidden="true"><use href="#i-arrow-right"/></svg>
          </a>
        </li>
        {% endfor %}
      </ul>
      {% endif %}

      {% if section.notes %}
      <ul class="bio-note-list">
        {% for note in section.notes %}<li>{{ note }}</li>{% endfor %}
      </ul>
      {% endif %}
    </section>
    {% endfor %}

    <div class="bio-qr">
      <div class="bio-qr-frame">
        <svg class="bio-qr-ring" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <polygon points="50,0.5 99.5,25.25 99.5,74.75 50,99.5 0.5,74.75 0.5,25.25" fill="none" stroke="#2b6df0" stroke-width="1" />
        </svg>
        <div class="bio-qr-card">
          <img class="bio-qr-img"
               src="{{ '/assets/img/bio/qr/grayminds-bio.svg' | relative_url }}"
               alt="QR code linking to grayminds.com/bio"
               width="182" height="182"
               loading="lazy" decoding="async" />
        </div>
      </div>
      <p class="bio-qr-caption">grayminds.com/bio</p>
    </div>

  </main>

  {%- comment -%}
    Layer 3 fallback for email obfuscation.  Uncomment if Cloudflare's
    "Email Address Obfuscation" Scrape Shield setting is later disabled
    on the grayminds.com zone.

    <script>
      document.querySelectorAll('a[href^="mailto:"]').forEach(function (a) {
        var raw = a.getAttribute('href').slice(7);
        var parts = raw.split('@');
        if (parts.length !== 2) return;
        a.setAttribute('href', '#');
        a.dataset.bioEmailUser = parts[0];
        a.dataset.bioEmailDomain = parts[1];
        a.addEventListener('click', function (e) {
          e.preventDefault();
          window.location.href = 'mailto:' + a.dataset.bioEmailUser + '@' + a.dataset.bioEmailDomain;
        });
      });
    </script>
  {%- endcomment -%}

</body>
</html>
